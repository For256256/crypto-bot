# ---- تنظیمات کریپتو بات (Toobit Futures) ----
DASHBOARD_PORT=8891
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# توکن امنیتی وبهوک TradingView — همین مقدار باید در پیام Alert باشد
WEBHOOK_TOKEN=change-me

# کلید امضای سشن (کوکی لاگین چندکاربره) — یک رشته‌ی تصادفی و طولانی
SESSION_SECRET_KEY=change-me

# آدرس عمومی سرویس، وقتی پشت دامنه و HTTPS اجرا می‌شود — بدون اسلش پایانی.
# مثال: https://cpulsepro.com
# اگر خالی بماند، آدرس وبهوک از روی خود درخواست ساخته می‌شود (نصب بدون دامنه).
PUBLIC_BASE_URL=

# ارسال کوکی لاگین فقط روی HTTPS. پیش‌فرض auto = روشن اگر PUBLIC_BASE_URL
# با https شروع شود. روی نصب بدون TLS دستی روشنش نکنید (لاگین از کار می‌افتد).
SESSION_COOKIE_SECURE=auto

# آدرس پایه API صرافی Toobit
TOOBIT_BASE_URL=https://api.toobit.com

# آدرس پایه API صرافی تبدیل (Tabdeal)
TABDEAL_BASE_URL=https://api1.tabdeal.org

# محل فایل پیکربندی حساب‌ها
ACCOUNTS_CONFIG_PATH=config/accounts.json

# محل فایل تاریخچه معاملات (گزارش سود/زیان)
HISTORY_PATH=config/history.json
