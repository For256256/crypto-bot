# ---- تنظیمات کریپتو بات (Toobit Futures) ----
DASHBOARD_PORT=8891
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# توکن امنیتی وبهوک TradingView — همین مقدار باید در پیام Alert باشد
WEBHOOK_TOKEN=change-me

# آدرس پایه API صرافی Toobit
TOOBIT_BASE_URL=https://api.toobit.com

# آدرس پایه API صرافی تبدیل (Tabdeal)
TABDEAL_BASE_URL=https://api1.tabdeal.org

# محل فایل پیکربندی حساب‌ها
ACCOUNTS_CONFIG_PATH=config/accounts.json

# محل فایل تاریخچه معاملات (گزارش سود/زیان)
HISTORY_PATH=config/history.json
